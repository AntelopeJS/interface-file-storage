      "expect": {
        "skills": ["file-storage-interface"],
        "acceptable": ["antelopejs", "core-interface"],
        "mustMention": ["IsFileNotFoundError"]
      }
    },
    {
      "id": "file-storage-interface-api-neighbour",
      "area": "modules",
      "style": "clean",
